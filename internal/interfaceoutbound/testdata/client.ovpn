client
dev tun
proto udp
remote vpn.example.com 1194
remote-cert-tls server
auth SHA256
data-ciphers AES-256-GCM:AES-128-GCM
auth-nocache
persist-key
persist-tun
verb 3
<ca>
-----BEGIN CERTIFICATE-----
TEST_ONLY_CA
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
TEST_ONLY_CERTIFICATE
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN PRIVATE KEY-----
TEST_ONLY_PRIVATE_KEY
-----END PRIVATE KEY-----
</key>
<auth-user-pass>
test-only-user
TEST_ONLY_PASSWORD
</auth-user-pass>
