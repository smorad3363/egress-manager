[Unit]
Description=Egress Manager owned Xray listener relay instance
Documentation=https://github.com/smorad3363/egress-manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=egress-manager
UMask=0077
ExecStart=/usr/local/lib/egress-manager/bin/xray run -config /var/lib/egress-manager/private/xray-relay.json
Restart=on-failure
RestartSec=2s
PrivateTmp=true
ProtectHome=true
ProtectHostname=true
ProtectClock=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
