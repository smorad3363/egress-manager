[Unit]
Description=Egress Manager unprivileged API service
Documentation=https://github.com/smorad3363/egress-manager
Requires=egressd.service
After=egressd.service
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
Type=simple
User=egress-web
Group=egress-manager
UMask=0007
ExecStart=/usr/local/lib/egress-manager/bin/egress-web --config /etc/egress-manager/config.json --ipc-key /etc/egress-manager/ipc.key
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/egress-manager/database

[Install]
WantedBy=multi-user.target
